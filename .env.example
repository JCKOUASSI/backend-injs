# =============================================================================
# .env PRODUCTION pour injs.badge-qr-code.pro (VPS 152.228.233.123)
# Copier vers .env : cp .env.example .env
# Puis éditer les secrets (DB_PASSWORD, DJANGO_SECRET_KEY, etc.)
# =============================================================================

# ---- Django (backend) - compatibilité: lit DEBUG ou DJANGO_DEBUG, SECRET_KEY ou DJANGO_SECRET_KEY ----
# En prod: DEBUG=0, SECRET_KEY fort (50+ caractères)
DEBUG=0
DJANGO_DEBUG=0
SECRET_KEY=change-me-avec-une-cle-forte-50-caracteres-minimum
DJANGO_SECRET_KEY=change-me-avec-une-cle-forte-50-caracteres-minimum

# Hôtes autorisés (séparés par virgules)
DJANGO_ALLOWED_HOSTS=injs.badge-qr-code.pro,localhost,127.0.0.1

# Origines de confiance CSRF/CORS (doivent être absolues https://)
CSRF_TRUSTED_ORIGINS=https://injs.badge-qr-code.pro
CORS_ALLOWED_ORIGINS=https://injs.badge-qr-code.pro

# Proxy TLS (Nginx termine TLS, Django doit faire confiance à X-Forwarded-Proto)
TRUST_FORWARDED_PROTO=1
USE_X_FORWARDED_HOST=1

# URLs publiques
FRONTEND_URL=https://injs.badge-qr-code.pro
PUBLIC_APP_URL=https://injs.badge-qr-code.pro
BADGE_BASE_URL=https://injs.badge-qr-code.pro
VITE_API_URL=https://injs.badge-qr-code.pro/api
VITE_BADGE_BASE_URL=https://injs.badge-qr-code.pro

# ---- Base de données ----
# Compatibilité: backend lit POSTGRES_* et DB_*
DB_ENGINE=django.db.backends.postgresql
DB_NAME=injs
DB_USER=injs
DB_PASSWORD=change-me-mot-de-passe-fort
DB_HOST=db
DB_PORT=5432
POSTGRES_DB=injs
POSTGRES_USER=injs
POSTGRES_PASSWORD=change-me-mot-de-passe-fort
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- Superutilisateur auto (créé au post_migrate si absent) ----
# IMPORTANT: pour que admin/admin123 fonctionne en prod, définir ces 3 vars
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@injs.local
DJANGO_SUPERUSER_PASSWORD=admin123

# ---- Email (optionnel) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@injs.badge-qr-code.pro

# ---- Gunicorn / scaling ----
GUNICORN_WORKERS=auto
GUNICORN_WORKERS_MIN=2
GUNICORN_WORKERS_MAX=10

# ---- Frontend (build arg) ----
# VITE_API_URL est figé au build de l'image frontend
# Doit être une URL absolue vers l'API, pas relative
VITE_API_URL=https://injs.badge-qr-code.pro/api

# ---- Sécurité prod ----
# Ne pas activer en prod sauf besoin debug
# DEMO_ADMIN_AUTOLOGIN=0
