# =============================================================================
# Modèle d'environnement INJS-LMD (Production & Staging)
# Copier vers .env : cp .env.example .env
# Remplacer les valeurs « change-me » par des secrets forts.
# =============================================================================

# ── Django Général ───────────────────────────────────────────
DEBUG=0
DJANGO_DEBUG=0
SECRET_KEY=change-me-avec-une-cle-secrete-forte-50-caracteres-minimum
DJANGO_SECRET_KEY=change-me-avec-une-cle-secrete-forte-50-caracteres-minimum

# Hôtes autorisés (séparés par virgules)
DJANGO_ALLOWED_HOSTS=injs.badge-qr-code.pro,localhost,127.0.0.1

# Origines de confiance CSRF/CORS (doivent être absolues https://)
CSRF_TRUSTED_ORIGINS=https://injs.badge-qr-code.pro
CORS_ALLOWED_ORIGINS=https://injs.badge-qr-code.pro

# Proxy TLS (Nginx termine TLS, Django doit faire confiance aux headers X-Forwarded-*)
TRUST_FORWARDED_PROTO=1
USE_X_FORWARDED_HOST=1

# Cookies dédiés (optionnel : modifier pour désamorcer un vieux cookie résiduel)
CSRF_COOKIE_NAME=csrftoken
SESSION_COOKIE_NAME=sessionid

# ── Base de données PostgreSQL ───────────────────────────────
# Support dual : variables DB_* (Docker Compose) et POSTGRES_* (Django)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=injs
POSTGRES_DB=injs
DB_USER=injs
POSTGRES_USER=injs
DB_PASSWORD=change-me-mot-de-passe-db-fort
POSTGRES_PASSWORD=change-me-mot-de-passe-db-fort
DB_HOST=db
POSTGRES_HOST=db
DB_PORT=5432
POSTGRES_PORT=5432

# ── Compte Administrateur Initial (idempotent via entrypoint / script) ──
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@injs.local
DJANGO_SUPERUSER_PASSWORD=admin123

# ── URLs Publiques ───────────────────────────────────────────
FRONTEND_URL=https://injs.badge-qr-code.pro
PUBLIC_APP_URL=https://injs.badge-qr-code.pro
BADGE_BASE_URL=https://injs.badge-qr-code.pro

# ── Frontend (Vite) ──────────────────────────────────────────
# Dans le conteneur Nginx, l'API est proxifiée via /api (relatif)
VITE_API_URL=/api
VITE_BADGE_BASE_URL=https://injs.badge-qr-code.pro

# ── Email (SMTP) ─────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@injs.badge-qr-code.pro

# ── Gunicorn / scaling ───────────────────────────────────────
GUNICORN_WORKERS=auto
GUNICORN_WORKERS_MIN=2
GUNICORN_WORKERS_MAX=8
