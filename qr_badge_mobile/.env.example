# Copie optionnelle : non utilisée par défaut par Flutter (l’app charge assets/app.env).
# Pour surcharger en local sans modifier assets/app.env, vous pouvez :
# - éditer assets/app.env (versionné), ou
# - utiliser flutter run --dart-define=API_BASE_URL=http://...

API_BASE_URL=http://127.0.0.1:8001
SUPERVISOR_LOGOUT_CODE=2026
DEV_API_HOST=
DEV_API_PORT=8001

# Secondes entre deux heartbeats auto (30–600)
HEARTBEAT_INTERVAL_SECONDS=60
