# URL du backend Django (login, scan, historique)
API_BASE_URL=https://api.sygepcpfae.org

# Politique de confidentialité (page login + menu)
PRIVACY_POLICY_URL=https://tobi-nw.github.io/legalsygepcpfae/legal/confidentialite-qr-badge-mobile.html

# Code demandé à la déconnexion (définir localement ou via --dart-define=SUPERVISOR_LOGOUT_CODE=...)
SUPERVISOR_LOGOUT_CODE=2026

# Optionnel : hôte LAN du Mac si vous n’utilisez pas API_BASE_URL complète (émulation / script)
DEV_API_HOST=
DEV_API_PORT=8001

# false = pas d'envoi heartbeat ni service arrière-plan (tests / debug)
# HEARTBEAT_ENABLED=false

# Intervalle entre deux heartbeats automatiques (secondes, 30–600) pendant une session ouverte
HEARTBEAT_INTERVAL_SECONDS=60
