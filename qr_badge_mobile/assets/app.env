# Variables lues par l’app (package flutter_dotenv).
# Priorité : --dart-define > ce fichier > valeurs par défaut dans le code.
# Pour un téléphone physique : mettez l’IP du Mac, ex. API_BASE_URL=http://192.168.1.12:8001

# URL du backend Django (login, scan, historique)
API_BASE_URL=https://api.badge-qr-code.pro

# Code demandé à la déconnexion (connu admin / chef CPFAE Admin)
SUPERVISOR_LOGOUT_CODE=2026

# Optionnel : hôte LAN du Mac si vous n’utilisez pas API_BASE_URL complète (émulation / script)
DEV_API_HOST=
DEV_API_PORT=8001

# Intervalle entre deux heartbeats automatiques (secondes, 30–600) pendant une session ouverte
HEARTBEAT_INTERVAL_SECONDS=60
