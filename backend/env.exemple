############################################
# Variables d'environnement (exemple)
#
# Ne pas commiter de vraies valeurs
# (surtout `SECRET_KEY`).
############################################

# Clé Django (secret)
SECRET_KEY=change-moi-avant-deployer

# Activer/Désactiver debug (true/false)
DEBUG=true

# Pour déploiements type Render (optionnel)
RENDER_EXTERNAL_HOSTNAME=

# Si tu veux restreindre les hosts acceptés (optionnel)
# Format: séparé par des virgules
# Exemple: DJANGO_ALLOWED_HOSTS=code-qr-badge.onrender.com,localhost
DJANGO_ALLOWED_HOSTS=https://code-qr-badge.onrender.com

# Origins CORS autorisées (optionnel)
# Format: http(s)://host:port séparés par des virgules
# Exemple: CORS_ALLOWED_ORIGINS=http://localhost:3000,https://code-qr-badge.onrender.com
CORS_ALLOWED_ORIGINS=https://code-qr-badge.onrender.com

# Origines CSRF autorisées (optionnel)
# Exemple: CSRF_TRUSTED_ORIGINS=https://ton-domaine.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://code-qr-badge.onrender.com

# URL de base pour les QR codes de badgeage (optionnel)
# Doit être accessible par les téléphones qui scannent le QR.
# En dev, auto-détecté (IP LAN). En prod, mettre l'URL publique.
# Exemple: BADGE_BASE_URL=https://mon-app.onrender.com
BADGE_BASE_URL=https://code-qr-badge.onrender.com

# Dossier SQLite (par défaut: BASE_DIR)
# Exemple: SQLITE_DIR=/data
SQLITE_DIR=/data

# URL du frontend React (utilisée pour le redirect depuis /)
# En dev: http://localhost:3000 (valeur par défaut)
# En prod: https://ton-app-frontend.com
FRONTEND_URL=https://code-qr-badge.onrender.com

# Dossier du cache fichier (FileBasedCache, utilisé en production)
# Le dossier doit être accessible en lecture/écriture par le serveur
CACHE_DIR=/data/cache

# Throttling DRF
# Format DRF: "N/min", "N/hour", etc.
THROTTLE_LOGIN_RATE=5/min
THROTTLE_SCAN_RATE=30/min

# Délai (en minutes) après la fin d'une séance avant de marquer un auditeur ABSENT_NON_BADGE
# Déclenché par: python manage.py auto_close_pointages
# Défaut : 60 minutes
AUTO_ABSENT_DELAI_MINUTES=60

# ── Email SMTP (Mailcow) ────────────────────────────────────
# En développement, laisser vide → les emails s'affichent dans la console Django.
# En production, renseigner les valeurs de votre serveur Mailcow.
#
# Port 587 — STARTTLS (recommandé) :
EMAIL_HOST=mail.ton-domaine.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=noreply@ton-domaine.com
EMAIL_HOST_PASSWORD=mot_de_passe_mailcow
DEFAULT_FROM_EMAIL=QR Badge <noreply@ton-domaine.com>
#
# Port 465 — SSL/TLS direct (alternative) :
# EMAIL_PORT=465
# EMAIL_USE_TLS=False
# EMAIL_USE_SSL=True
#
# Pour forcer un backend particulier (optionnel) :
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

