# INJS-LMD Environment Configuration
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_SETTINGS_MODULE=injs_lmd.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
POSTGRES_DB=injs_lmd
POSTGRES_USER=injs
POSTGRES_PASSWORD=injs_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base de données : SQLite par défaut en local (aucune config requise)
# Mettre USE_POSTGRES=true uniquement pour Docker / PostgreSQL
USE_POSTGRES=false

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=amqp://injs:injs@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO
USE_S3=false
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=injs-documents

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:8080

# Payment providers (sandbox)
ORANGE_MONEY_ENABLED=true
MTN_MOMO_ENABLED=true
MOOV_MONEY_ENABLED=true
WAVE_ENABLED=true
STRIPE_ENABLED=true
PAYMENT_CALLBACK_URL=http://localhost:8001/api/v1/finance/webhooks/

# LMD rules (conditions de validation INJS)
LMD_PASSING_AVERAGE=10.0
LMD_COMPENSATION_FLOOR=8.0
LMD_CC_WEIGHT=0.4
LMD_CT_WEIGHT=0.6
LMD_MIN_CREDITS_RATIO=0.8
LMD_MAX_ABSENCE_RATE=0.25
LMD_MENTION_TRES_BIEN=16.0
LMD_MENTION_BIEN=14.0
LMD_MENTION_ASSEZ_BIEN=12.0
LMD_MENTION_PASSABLE=10.0
